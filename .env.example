JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=900000
ANALYTICS_QUERY_PASSWORD=replace-with-a-long-url-safe-password
ANALYTICS_SYNC_PASSWORD=replace-with-a-different-long-url-safe-password
DB_USER=postgres
DB_PASSWORD=replace-me
USER_BASE_URL=http://user-service:8081
VAULT_LOCAL_UNKEY=replace-me
VAULT_LOCAL_ROOT_TOKEN=replace-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-me

# Both keys must belong to the same Stripe account and mode (test or live).
# The secret key stays in Vault/payment-service; only the pk_ key reaches Stripe.js.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public HTTPS ingress used by Shopify/WooCommerce to call OAuth and webhook endpoints.
INTEGRATION_PUBLIC_BASE_URL=https://api.example.com
INTEGRATION_ORDER_CURRENCY=MAD
INTERNAL_HTTP_CONNECT_TIMEOUT=5s
INTERNAL_HTTP_READ_TIMEOUT=30s
INTERNAL_HTTP_MAX_ATTEMPTS=3
INTERNAL_HTTP_RETRY_BACKOFF=500ms
FRONTEND_PUBLIC_URL=https://app.example.com
# Optional: when omitted, vault-init generates and persists a random AES-256 key.
INTEGRATION_CREDENTIALS_MASTER_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_products
SHOPIFY_API_VERSION=2026-07

NVIDIA_API_KEY=replace-me
NVIDIA_MODEL=replace-me
AGENT_LLM_PROVIDER=none
MAIL_HOST=replace-me
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-me
PLATFORM_ADMIN_FIRSTNAME=Platform
PLATFORM_ADMIN_LASTNAME=Admin
